{
  "name": "zaka-e-hailing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:web": "VITE_APP_TARGET=web vite build",
    "build:rider-ios": "VITE_APP_TARGET=rider-ios vite build && npx cap sync ios",
    "cap:sync": "npx cap sync ios",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit --skipLibCheck --module esnext --moduleResolution bundler --target es2022 --lib es2022,dom --strict --resolveJsonModule --types node server.ts"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
