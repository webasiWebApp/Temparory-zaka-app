{
	"appId": "app.zaka.rider",
	"appName": "ZAKA",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"iosScheme": "https"
	},
	"ios": {
		"contentInset": "always",
		"preferredContentMode": "mobile",
		"scheme": "ZAKA"
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"StatusBar": {
			"style": "DARK",
			"overlaysWebView": true
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"GeolocationPlugin",
		"HapticsPlugin",
		"PushNotificationsPlugin",
		"StatusBarPlugin"
	]
}
