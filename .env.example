# ==============================================================================
# ZAKA E-HAILING PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Demo Mode - PRODUCTION BUILDS MUST LEAVE THIS 'false'
# 'true' enables the demo personas / simulator for sales demonstrations only.
# The demo accounts' password is supplied here at build time and is never kept in source control.
# ------------------------------------------------------------------------------
VITE_ENABLE_DEMO_MODE=false
VITE_DEMO_ACCOUNT_PASSWORD=

# ------------------------------------------------------------------------------
# Backend address
# ------------------------------------------------------------------------------
# Web: leave empty (the ZAKA server serves the app, so API calls are same-origin).
# Native iOS build: REQUIRED - the public https address of the ZAKA server, e.g. https://app.zaka.io
VITE_API_BASE_URL=

# Public address of this server (used for payment return links). Recommended in production.
APP_PUBLIC_URL=

# Comma-separated browser origins allowed to call the API (your web domain). Native app origins are built in.
CORS_ALLOWED_ORIGINS=

# Server port (default 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Google Maps Platform Configuration
# ------------------------------------------------------------------------------
# Google Maps JavaScript API Key with Maps JavaScript, Routes, and Places enabled
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Peach Payments Gateway Configuration (South Africa)
# ------------------------------------------------------------------------------
# Environment Switch: 'sandbox' (testing) or 'production' (live transactions)
PEACH_ENV=sandbox

# Channel / Entity ID obtained from Peach Payments Dashboard > Checkout
PEACH_ENTITY_ID=

# Secret Token used for HMAC-SHA256 signature verification & payload signing
PEACH_SECRET_TOKEN=

# Peach API Client Credentials (optional for OAuth API token generation)
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=

# Webhook secret for validating Peach server-to-server callback signatures.
# REQUIRED for webhooks: without it the webhook endpoint rejects every request.
PEACH_WEBHOOK_SECRET=

# Exact webhook URL registered in the Peach dashboard (part of the signed message)
PEACH_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# ZAKA Platform Financial Parameters
# ------------------------------------------------------------------------------
# Platform Commission (15% platform fee, 85% driver take-home)
ZAKA_PLATFORM_COMMISSION_PERCENT=15

# Backend Service Account for Admin Execution & Payment Finalization
# (a Firebase Auth user with a VERIFIED email; the server refuses to start without both values)
ZAKA_BACKEND_SERVICE_EMAIL=zaka.backend.service@zaka.io
ZAKA_BACKEND_SERVICE_PASSWORD=

# Admin allow-list used by the server (must match isRealAdmin() in firestore.rules / storage.rules)
ZAKA_ADMIN_UIDS=
ZAKA_ADMIN_EMAILS=admin@zaka.io

# ------------------------------------------------------------------------------
# POPIA data retention (days). Enforced automatically by the server once a day.
# ------------------------------------------------------------------------------
# Finished rides: addresses, exact coordinates and phone numbers are removed after this period
POPIA_RETENTION_DAYS=365
# Notifications are deleted after this period
POPIA_NOTIFICATION_RETENTION_DAYS=90
# Last known passenger location is cleared after this period
POPIA_LOCATION_RETENTION_DAYS=30
# Guest/demo sessions and sign-ups that were never verified are deleted after this period
POPIA_GUEST_RETENTION_DAYS=30

# A driver whose app stops sending its heartbeat is taken offline after this many milliseconds
DRIVER_HEARTBEAT_TIMEOUT_MS=180000
