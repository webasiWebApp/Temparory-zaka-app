{"nodes": [{"id": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732", "label": "iOS Splash Screen Image (2732x2732)", "file_type": "image", "source_file": "ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Square 2732x2732 launch splash asset for the iOS app. Plain white background with a single small blue gradient logo mark centered: two offset diagonal bars with short perpendicular arms forming an X-like glyph. No text, no ZAKA branding."}, {"id": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732_centered_logo_mark", "label": "Centered Blue Gradient Logo Mark", "file_type": "concept", "source_file": "ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Small light-to-mid blue gradient glyph of two parallel diagonal bars with perpendicular arms, occupying roughly 6 percent of the canvas width at dead center. Visually matches the stock Capacitor framework logo rather than a custom app brand."}, {"id": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732_default_capacitor_splash_placeholder", "label": "Default Capacitor Splash Placeholder", "file_type": "concept", "source_file": "ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The splash appears to be the unmodified template asset generated when the Capacitor iOS platform is added, meaning the app-specific ZAKA launch branding has not been applied to the iOS splash."}, {"id": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732_universal_square_splash_layout", "label": "Universal Square Splash Layout", "file_type": "rationale", "source_file": "ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single oversized square canvas (2732px matches the long edge of the largest iPad) with a tiny centered mark and wide empty margins lets one image be center-cropped to any device size and orientation without clipping the logo."}], "edges": [{"source": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732", "target": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732_centered_logo_mark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732.png", "source_location": null, "weight": 1.0}, {"source": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732", "target": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732_default_capacitor_splash_placeholder", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732.png", "source_location": null, "weight": 1.0}, {"source": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732_centered_logo_mark", "target": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732_default_capacitor_splash_placeholder", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732.png", "source_location": null, "weight": 1.0}, {"source": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732_universal_square_splash_layout", "target": "ios_app_app_assets_xcassets_splash_imageset_splash_2732x2732", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732.png", "source_location": null, "weight": 1.0}], "hyperedges": []}