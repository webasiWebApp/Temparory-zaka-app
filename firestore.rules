rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS & AUTHORIZATION PREDICATES
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return hasUserDoc() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }
    
    // Real, verified administrator check (hardened against client-side self-escalation)
    function isRealAdmin() {
      return isAuthenticated() && !isAnonymous() && (
        request.auth.token.get('role', '') == 'admin' || 
        request.auth.uid in ['Js6QAJWZskfRhInQFlX4fjlZ9Ws1', 'KCKA8mq7u6Udj5Lp4pIMSqlEgPJ2'] ||
        (
          (request.auth.token.get('email_verified', false) == true || request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com') &&
          request.auth.token.get('email', '') in ['admin@zaka.io', 'zaka.backend.service@zaka.io', 'webasiinfo@gmail.com']
        )
      );
    }

    function isDemoAdmin() {
      return false;
    }

    // Email-verified (or federated-provider) account: required for protected operations such as requesting a ride
    function isVerifiedAccount() {
      return isAuthenticated() && !isAnonymous() && (
        request.auth.token.get('email_verified', false) == true ||
        request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com']
      );
    }
    
    function isAdmin() {
      return isRealAdmin();
    }

    // A passenger's identity details are frozen while their submission is pending or approved
    function passengerIdentityLocked(userId) {
      return exists(/databases/$(database)/documents/passengers/$(userId)) &&
        get(/databases/$(database)/documents/passengers/$(userId)).data.get('verificationStatus', 'unverified') in ['pending', 'approved'];
    }

    // Admin has approved this passenger's identity (ID document + live photo)
    function isApprovedPassenger() {
      return exists(/databases/$(database)/documents/passengers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/passengers/$(request.auth.uid)).data.get('verificationStatus', 'unverified') == 'approved';
    }

    function isDriver() {
      return (hasUserDoc() && getUserData().get('role', '') == 'driver') ||
             exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }

    // ==========================================
    // 1. USERS COLLECTION (ZAKA Single Identity)
    // ==========================================
    match /users/{userId} {
      // Users can only read their own profile document unless Admin
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isRealAdmin() || 
        (isDemoAdmin() && resource.data.get('isDemo', false) == true)
      );
      
      // Newly authenticated users can create their own profile document as passenger or driver.
      // Admin role can NEVER be created by normal users.
      allow create: if isAuthenticated() && (
        (
          request.auth.uid == userId && 
          request.resource.data.get('role', 'passenger') in ['passenger', 'driver'] &&
          !request.resource.data.get('roles', []).hasAny(['admin'])
        ) ||
        isRealAdmin()
      );
      
      // Users can update their own profile but CANNOT self-escalate to admin or tamper with roles.
      // Users can add 'driver' to roles array during driver onboarding, but NEVER 'admin'.
      allow update: if isAuthenticated() && (
        isRealAdmin() || 
        (isDemoAdmin() && resource.data.get('isDemo', false) == true) ||
        (
          request.auth.uid == userId && 
          request.resource.data.get('role', 'passenger') in ['passenger', 'driver'] &&
          request.resource.data.get('activeRole', 'passenger') in ['passenger', 'driver'] &&
          !request.resource.data.get('roles', []).hasAny(['admin']) &&
          request.resource.data.get('status', 'active') in [resource.data.get('status', 'active'), 'deleted'] &&
          request.resource.data.get('accountStatus', 'active') in [resource.data.get('accountStatus', 'active'), 'deleted'] &&
          // The name on a passenger's identity submission cannot be changed while it is pending or approved
          (
            request.resource.data.get('name', '') == resource.data.get('name', '') ||
            !passengerIdentityLocked(userId)
          )
        )
      );
      
      allow delete: if (isAuthenticated() && request.auth.uid == userId) || isRealAdmin() || (isDemoAdmin() && resource.data.get('isDemo', false) == true);

      // Recent destinations subcollection - private to passenger owner
      match /recentDestinations/{destinationId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == userId || 
          isRealAdmin() || 
          (isDemoAdmin() && resource.data.get('isDemo', false) == true)
        );
      }
    }

    // ==========================================
    // 2. PASSENGERS COLLECTION
    // ==========================================
    match /passengers/{passengerId} {
      function passengerChangedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // The review outcome belongs to Admin. A passenger may only (re)submit for review ('pending'),
      // and the identity details are frozen while a submission is pending or approved.
      function passengerVerificationChangeAllowed() {
        return !passengerChangedKeys().hasAny(['verificationReviewedAt', 'verificationReviewedBy', 'rejectionReason']) &&
          (
            !passengerChangedKeys().hasAny(['verificationStatus']) ||
            (
              request.resource.data.verificationStatus == 'pending' &&
              resource.data.get('verificationStatus', 'unverified') != 'approved'
            )
          ) &&
          (
            !(resource.data.get('verificationStatus', 'unverified') in ['pending', 'approved']) ||
            !passengerChangedKeys().hasAny(['name', 'dateOfBirth', 'gender', 'nationality', 'idNumber'])
          );
      }

      // 'phoneVerified' may only be true for the number confirmed by SMS code on this account
      function passengerPhoneChangeAllowed() {
        return !passengerChangedKeys().hasAny(['phone', 'phoneVerified']) ||
          request.resource.data.get('phoneVerified', false) != true ||
          request.auth.token.get('phone_number', '') == request.resource.data.get('phone', '');
      }

      // Passengers read own profile; Admin reads all; Drivers CANNOT read all passengers
      allow read: if isAuthenticated() && (
        request.auth.uid == passengerId ||
        isRealAdmin() ||
        (resource.data.get('isDemo', false) == true && isAnonymous())
      );
      // walletBalance is credited/debited ONLY by the backend (top-ups and ride payments).
      // Real accounts always start at zero; only isolated demo profiles may carry a seeded balance.
      allow create: if isAuthenticated() && (
        isRealAdmin() ||
        (
          request.auth.uid == passengerId &&
          (
            request.resource.data.get('walletBalance', 0) == 0 ||
            request.resource.data.get('isDemo', false) == true
          ) &&
          // A new profile can never start out approved or with a phone number that was not confirmed
          request.resource.data.get('verificationStatus', 'unverified') in ['unverified', 'pending'] &&
          (
            request.resource.data.get('phoneVerified', false) != true ||
            request.auth.token.get('phone_number', '') == request.resource.data.get('phone', '')
          )
        ) ||
        (isAnonymous() && request.resource.data.get('isDemo', false) == true)
      );
      allow update: if isAuthenticated() && (
        isRealAdmin() ||
        (
          request.auth.uid == passengerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'isDemo']) &&
          passengerVerificationChangeAllowed() &&
          passengerPhoneChangeAllowed()
        ) ||
        // Trip counter only. Rating averages are written by the backend (/api/ratings/submit).
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalTrips', 'updatedAt'])
      );
      allow delete: if (isAuthenticated() && request.auth.uid == passengerId) || isRealAdmin();

      // Identity verification photos (ID document + live selfie): the passenger and Admin only.
      // They cannot be replaced while a submission is pending or approved.
      match /verification/{imageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == passengerId ||
          isRealAdmin()
        );
        allow create, update: if isAuthenticated() && (
          isRealAdmin() ||
          (
            request.auth.uid == passengerId &&
            imageId in ['idDocument', 'selfie'] &&
            !passengerIdentityLocked(passengerId)
          )
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == passengerId ||
          isRealAdmin()
        );
      }
    }

    // ==========================================
    // 3. DRIVERS COLLECTION
    // ==========================================
    // A driver can ONLY read their own profile; admins can read all;
    // Online & verified drivers readable by passengers for map radar (never by other drivers)
    match /drivers/{driverId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == driverId ||
        isRealAdmin() ||
        (
          !isDriver() &&
          resource.data.get('online', false) == true &&
          resource.data.get('verificationStatus', '') == 'approved'
        ) ||
        (resource.data.get('isDemo', false) == true && isAnonymous())
      );

      // Driver registers their doc with verificationStatus strictly 'pending'
      allow create: if isAuthenticated() && (
        isRealAdmin() || 
        (isDemoAdmin() && request.resource.data.get('isDemo', false) == true) ||
        (
          !isAnonymous() &&
          request.auth.uid == driverId && 
          request.resource.data.get('isDemo', false) != true &&
          request.resource.data.get('verificationStatus', 'pending') == 'pending'
        ) ||
        (
          request.auth.uid == driverId &&
          request.resource.data.get('isDemo', false) == true &&
          (isAnonymous() || request.resource.data.get('demoPersona', '') in ['sipho', 'kofi'])
        )
      );

      // Driver can update online status/location/documents, but CANNOT change verificationStatus unless Admin
      // And CANNOT toggle online: true unless verificationStatus == 'approved'
      // And CANNOT tamper with ratings, earnings, commission, suspension, or approval fields
      allow update: if isAuthenticated() && (
        isRealAdmin() || 
        (isDemoAdmin() && resource.data.get('isDemo', false) == true) ||
        (
          request.auth.uid == driverId && (
            (
              resource.data.get('isDemo', false) != true &&
              (!request.resource.data.get('online', false) || resource.data.get('verificationStatus', '') == 'approved') &&
              request.resource.data.get('verificationStatus', 'pending') == resource.data.get('verificationStatus', 'pending') &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'verificationStatus', 'rating', 'totalRatings', 'ratingSum',
                'platformCommission', 'earningsToday', 'earningsThisWeek', 'totalEarnings',
                'suspended', 'suspensionStatus', 'suspensionReason', 'suspendedAt',
                'approvedAt', 'approvedBy', 'approvalStatus'
              ])
            ) ||
            (
              resource.data.get('isDemo', false) == true && 
              request.resource.data.get('isDemo', false) == true
            )
          )
        ) ||
        // Rating averages are written by the backend (/api/ratings/submit), never by another user
        (resource.data.get('isDemo', false) == true && (isAnonymous() || isAnonymous()))
      );

      allow delete: if isRealAdmin() || (isDemoAdmin() && resource.data.get('isDemo', false) == true);

      // Private verification documents subcollection: driver and Admin only
      match /documents/{docId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == driverId ||
          isRealAdmin() ||
          (isDemoAdmin() && get(/databases/$(database)/documents/drivers/$(driverId)).data.get('isDemo', false) == true)
        );
        allow create, update: if isAuthenticated() && (
          isRealAdmin() ||
          (isDemoAdmin() && get(/databases/$(database)/documents/drivers/$(driverId)).data.get('isDemo', false) == true) ||
          (
            request.auth.uid == driverId &&
            request.resource.data.get('status', 'pending') == 'pending'
          )
        );
        allow delete: if isRealAdmin();
      }
    }

    // ==========================================
    // 4. DRIVER COMPLIANCE COLLECTION
    // ==========================================
    match /driverCompliance/{driverId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == driverId || isRealAdmin()
      );
      allow write: if isRealAdmin();

      match /documents/{docId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == driverId || isRealAdmin()
        );
        allow create, update: if isAuthenticated() && (
          isRealAdmin() ||
          (
            request.auth.uid == driverId &&
            request.resource.data.get('status', 'pending') == 'pending' &&
            request.resource.data.get('verificationStatus', 'pending') == 'pending'
          )
        );
        allow delete: if isRealAdmin();
      }
    }

    // ==========================================
    // 4b. DRIVER DOCUMENT CONTENTS (Base64 storage cache)
    // ==========================================
    match /driver_document_contents/{docKey} {
      allow read: if isAuthenticated() && (
        isRealAdmin() ||
        resource.data.driverId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        isRealAdmin() ||
        request.resource.data.driverId == request.auth.uid
      );
      allow delete: if isRealAdmin();
    }

    // ==========================================
    // 5. VEHICLES & VEHICLE COMPLIANCE
    // ==========================================
    match /vehicles/{vehicleId} {
      // Driver can read their own vehicle; Admin can read all vehicles;
      // Other drivers CANNOT read all vehicles
      allow read: if isAuthenticated() && (
        request.auth.uid == vehicleId ||
        resource.data.get('driverId', '') == request.auth.uid ||
        isRealAdmin() ||
        (isDemoAdmin() && resource.data.get('isDemo', false) == true) ||
        (resource.data.get('isDemo', false) == true && (isAnonymous() || isAnonymous()))
      );
      // Drivers can create vehicle doc with status: 'pending'
      allow create: if isAuthenticated() && (
        isRealAdmin() ||
        (
          (request.auth.uid == vehicleId || request.resource.data.get('driverId', '') == request.auth.uid) &&
          request.resource.data.get('status', 'pending') == 'pending'
        ) ||
        (request.resource.data.get('isDemo', false) == true)
      );
      // Driver cannot modify vehicle approval status or verification status
      allow update: if isAuthenticated() && (
        isRealAdmin() ||
        (
          (request.auth.uid == vehicleId || resource.data.get('driverId', '') == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verificationStatus', 'approvedAt', 'approvedBy'])
        ) ||
        (resource.data.get('isDemo', false) == true && request.resource.data.get('isDemo', false) == true)
      );
      allow delete: if isRealAdmin() || (isDemoAdmin() && resource.data.get('isDemo', false) == true);
    }

    match /vehicleCompliance/{vehicleId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == vehicleId || 
        resource.data.get('driverId', '') == request.auth.uid || 
        isRealAdmin()
      );
      allow write: if isRealAdmin();

      match /documents/{docId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == vehicleId || 
          isRealAdmin()
        );
        allow create, update: if isAuthenticated() && (
          isRealAdmin() ||
          (
            request.auth.uid == vehicleId &&
            request.resource.data.get('status', 'pending') == 'pending'
          )
        );
        allow delete: if isRealAdmin();
      }
    }

    // ==========================================
    // 6. RIDES COLLECTION
    // ==========================================
    // Visibility:
    // - Passenger reads only when passengerId == request.auth.uid
    // - Driver reads only when driverId == request.auth.uid, OR searching rides for dispatch
    // - Admin reads all rides
    // - Drivers CANNOT query all rides (bulk collection read rejected for non-admin)
    match /rides/{rideId} {
      // Fields fixed at request time. Neither party may alter them afterwards (fare integrity).
      function lockedRideKeys() {
        return [
          'passengerId', 'estimatedFare', 'baseFare', 'distanceFare', 'timeFare', 'fare',
          'platformFee', 'platformCommission', 'distanceKm', 'estimatedDistanceKm',
          'estimatedDurationMin', 'estimatedDurationMinutes', 'rideType', 'pickupLocation',
          'destinationLocation', 'currency', 'isDemo', 'otp'
        ];
      }

      function changedRideKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Safety PIN: the driver must submit the passenger's 4-digit PIN to start the trip.
      // The PIN lives in /rides/{rideId}/private/pin, which the driver can never read.
      // (Second clause keeps rides created before the private PIN document existed startable.)
      function pinVerified() {
        return (
          exists(/databases/$(database)/documents/rides/$(rideId)/private/pin) &&
          request.resource.data.get('enteredPin', '') ==
            get(/databases/$(database)/documents/rides/$(rideId)/private/pin).data.otp
        ) || (
          !exists(/databases/$(database)/documents/rides/$(rideId)/private/pin) &&
          resource.data.get('otp', '') != '' &&
          request.resource.data.get('enteredPin', '') == resource.data.otp
        );
      }

      // Driver side of the lifecycle: accepted -> driver_arriving -> driver_arrived -> in_progress -> completed
      function driverTransitionAllowed() {
        return request.resource.data.status == resource.data.status ||
          (resource.data.status == 'accepted' && request.resource.data.status in ['driver_arriving', 'cancelled']) ||
          (resource.data.status == 'driver_arriving' && request.resource.data.status in ['driver_arrived', 'cancelled']) ||
          (resource.data.status == 'driver_arrived' && request.resource.data.status == 'cancelled') ||
          (resource.data.status == 'driver_arrived' && request.resource.data.status == 'in_progress' && pinVerified()) ||
          (resource.data.status == 'in_progress' && request.resource.data.status in ['completed', 'cancelled']);
      }

      // Only cash can be confirmed by the driver. Card / wallet are settled by the backend.
      function driverPaymentChangeAllowed() {
        return !changedRideKeys().hasAny(['paymentStatus']) ||
          request.resource.data.paymentStatus == 'pending' ||
          (
            request.resource.data.paymentStatus == 'paid' &&
            resource.data.get('paymentMethod', 'cash') == 'cash' &&
            resource.data.status == 'completed'
          );
      }

      function passengerTransitionAllowed() {
        return request.resource.data.status == resource.data.status ||
          (
            request.resource.data.status == 'cancelled' &&
            resource.data.status in ['searching', 'accepted', 'driver_arriving', 'driver_arrived']
          );
      }

      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.passengerId ||
        request.auth.uid == resource.data.driverId ||
        (resource.data.status == 'searching' && (
          (!isAnonymous() && resource.data.get('isDemo', false) == false && isDriver()) ||
          (resource.data.get('isDemo', false) == true)
        )) ||
        isRealAdmin() ||
        (isDemoAdmin() && resource.data.get('isDemo', false) == true) ||
        (resource.data.get('isDemo', false) == true && isAnonymous())
      );

      // Real rides: verified account with an Admin-approved identity, always start unassigned, unpaid and 'searching'
      allow create: if isAuthenticated() && (
        (
          isVerifiedAccount() &&
          (isApprovedPassenger() || isRealAdmin()) &&
          request.resource.data.passengerId == request.auth.uid &&
          request.resource.data.get('isDemo', false) != true &&
          request.resource.data.status == 'searching' &&
          request.resource.data.get('driverId', null) == null &&
          request.resource.data.get('paymentStatus', 'pending') == 'pending' &&
          request.resource.data.estimatedFare is number &&
          request.resource.data.estimatedFare > 0
        ) ||
        (request.resource.data.get('isDemo', false) == true && (isAnonymous() || request.resource.data.passengerId == request.auth.uid))
      );

      allow update: if isAuthenticated() && (
        isRealAdmin() ||
        (isDemoAdmin() && resource.data.get('isDemo', false) == true) ||
        (
          resource.data.get('isDemo', false) != true && (
            // Passenger: may cancel before the trip starts, retry the search, or switch an unpaid ride to cash
            (
              resource.data.passengerId == request.auth.uid &&
              !changedRideKeys().hasAny(lockedRideKeys()) &&
              !changedRideKeys().hasAny([
                'driverId', 'driverName', 'driverPhone', 'vehicleDetails',
                'finalFare', 'paymentStatus', 'enteredPin', 'startedAt', 'completedAt'
              ]) &&
              passengerTransitionAllowed() &&
              (
                !changedRideKeys().hasAny(['paymentMethod']) ||
                resource.data.get('paymentStatus', 'pending') != 'paid'
              )
            ) ||
            // Assigned driver: lifecycle transitions only, PIN required to start, fare cannot be altered
            (
              resource.data.driverId == request.auth.uid &&
              request.resource.data.driverId == request.auth.uid &&
              !changedRideKeys().hasAny(lockedRideKeys()) &&
              !changedRideKeys().hasAny(['paymentMethod']) &&
              (
                !changedRideKeys().hasAny(['finalFare']) ||
                request.resource.data.finalFare == resource.data.estimatedFare
              ) &&
              driverTransitionAllowed() &&
              driverPaymentChangeAllowed()
            ) ||
            // Atomic acceptance of an unassigned ride by an approved driver
            (
              resource.data.status == 'searching' &&
              resource.data.get('driverId', null) == null &&
              request.resource.data.driverId == request.auth.uid &&
              request.resource.data.status == 'accepted' &&
              !changedRideKeys().hasAny(lockedRideKeys()) &&
              !changedRideKeys().hasAny(['finalFare', 'paymentStatus', 'paymentMethod', 'enteredPin']) &&
              isDriver() &&
              get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.get('verificationStatus', '') == 'approved'
            )
          )
        ) ||
        (
          resource.data.get('isDemo', false) == true &&
          request.resource.data.get('isDemo', false) == true && (
            isAnonymous() ||
            resource.data.passengerId == request.auth.uid ||
            resource.data.driverId == request.auth.uid ||
            request.resource.data.driverId == request.auth.uid
          )
        )
      );

      allow delete: if isRealAdmin() || (isDemoAdmin() && resource.data.get('isDemo', false) == true);

      // Private ride secrets (Safety PIN). Readable by the passenger and Admin only - never by the driver.
      match /private/{secretId} {
        allow read: if isAuthenticated() && (
          isRealAdmin() ||
          get(/databases/$(database)/documents/rides/$(rideId)).data.passengerId == request.auth.uid
        );
        allow create: if isAuthenticated() &&
          getAfter(/databases/$(database)/documents/rides/$(rideId)).data.passengerId == request.auth.uid &&
          request.resource.data.otp is string &&
          request.resource.data.otp.size() == 4;
        allow update, delete: if isRealAdmin();
      }
    }

    // ==========================================
    // 7. PAYMENTS COLLECTION
    // ==========================================
    // Driver can ONLY read payments where driverId == request.auth.uid
    // Passenger can ONLY read payments where passengerId == request.auth.uid
    // Platform revenue & full ledger readable ONLY by Admin
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isRealAdmin() ||
        (isDemoAdmin() && resource.data.get('isDemo', false) == true) ||
        (resource.data.get('isDemo', false) == true && (isAnonymous() || isAnonymous())) ||
        (resource.data.get('isDemo', false) != true && (
          request.auth.uid == resource.data.passengerId ||
          request.auth.uid == resource.data.driverId
        ))
      );
      
      // Clients may record a pending payment; only the backend (card / wallet) or the
      // assigned driver (cash in hand) can produce a 'paid' record.
      allow create: if isAuthenticated() && (
        isRealAdmin() ||
        (
          (!isAnonymous() || request.resource.data.get('isDemo', false) == true) && (
            request.auth.uid == request.resource.data.passengerId ||
            request.auth.uid == request.resource.data.driverId
          ) && (
            request.resource.data.get('paymentStatus', 'pending') != 'paid' ||
            (
              request.resource.data.get('paymentMethod', '') == 'cash' &&
              request.auth.uid == request.resource.data.driverId
            )
          )
        )
      );
      
      // Clients cannot tamper with amounts, commission, or driver earnings
      allow update: if isAuthenticated() && (
        isRealAdmin() || 
        (isDemoAdmin() && resource.data.get('isDemo', false) == true) || 
        (
          (!isAnonymous() || resource.data.get('isDemo', false) == true) && 
          (request.auth.uid == resource.data.driverId || request.auth.uid == resource.data.passengerId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'amount', 'currency', 'platformFee', 'platformCommission',
            'driverEarnings', 'driverAmount', 'isDemo', 'providerTransactionId', 'merchantTransactionId'
          ]) &&
          (
            request.resource.data.get('paymentStatus', 'pending') != 'paid' || 
            (resource.data.get('paymentMethod', 'cash') == 'cash' && request.auth.uid == resource.data.driverId)
          )
        )
      );

      allow delete: if isRealAdmin();
    }

    // ==========================================
    // 8. RATINGS COLLECTION
    // ==========================================
    match /ratings/{ratingId} {
      // Users can only read ratings they are a participant in (fromUserId, toUserId, passengerId, driverId)
      allow read: if isAuthenticated() && (
        isRealAdmin() ||
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId ||
        request.auth.uid == resource.data.passengerId ||
        request.auth.uid == resource.data.driverId
      );
      allow create: if isAuthenticated() && (
        isRealAdmin() ||
        (
          // Real ratings are created by the backend only; clients may write demo ratings
          request.resource.data.get('isDemo', false) == true &&
          (request.auth.uid == request.resource.data.fromUserId ||
           request.auth.uid == request.resource.data.passengerId ||
           request.auth.uid == request.resource.data.driverId) &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5
        )
      );
      allow update: if isAuthenticated() && (
        isRealAdmin() ||
        request.auth.uid == resource.data.fromUserId
      );
      allow delete: if isRealAdmin();
    }

    // ==========================================
    // 9. NOTIFICATIONS COLLECTION
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isRealAdmin() ||
        (isDemoAdmin() && resource.data.get('isDemo', false) == true) ||
        request.auth.uid == resource.data.userId
      );
      allow create: if isAuthenticated() && (
        isRealAdmin() ||
        (
          request.resource.data.userId != null &&
          request.resource.data.userId != '' &&
          // Allow self-notifications and cross-user ride/payment/system notifications
          // (ride lifecycle events, chat, payment confirmations, SOS alerts)
          (
            request.resource.data.userId == request.auth.uid ||
            request.resource.data.type in ['ride', 'payment', 'system']
          )
        )
      );
      allow update: if isAuthenticated() && (
        isRealAdmin() || 
        request.auth.uid == resource.data.userId
      );
      allow delete: if isAuthenticated() && (
        isRealAdmin() || 
        request.auth.uid == resource.data.userId
      );
    }

    // ==========================================
    // 10. PRICING & PRICING CONFIGS
    // ==========================================
    match /pricing/{rideType} {
      allow read: if true;
      allow write: if isRealAdmin();
    }

    match /pricingConfigs/{configId} {
      allow read: if true;
      allow write: if isRealAdmin();
    }

    // ==========================================
    // 11. INCIDENTS & SAFETY
    // ==========================================
    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && (
        isRealAdmin() || 
        resource.data.reportedBy == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.passengerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isRealAdmin() || 
        request.resource.data.reportedBy == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isRealAdmin() || 
        (resource.data.reportedBy == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'resolution', 'resolvedAt', 'resolvedBy']))
      );
      allow delete: if isRealAdmin();
    }

    // ==========================================
    // 12. SUPPORT TICKETS
    // ==========================================
    match /support/{ticketId} {
      allow read: if isAuthenticated() && (
        isRealAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isRealAdmin() || 
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isRealAdmin() || 
        (resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'priority', 'assignedTo']))
      );
      allow delete: if isRealAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isRealAdmin() || 
          get(/databases/$(database)/documents/support/$(ticketId)).data.userId == request.auth.uid
        );
        allow create: if isAuthenticated() && (
          isRealAdmin() || 
          (
            get(/databases/$(database)/documents/support/$(ticketId)).data.userId == request.auth.uid &&
            request.resource.data.senderId == request.auth.uid
          )
        );
        allow delete: if isRealAdmin();
      }
    }

    // ==========================================
    // 13. AUDIT LOGS
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isRealAdmin();
      allow create: if isRealAdmin() || (isAuthenticated() && request.resource.data.get('action', '') == 'DRIVER_EMERGENCY_SOS');
      allow update, delete: if isRealAdmin();
    }

    // ==========================================
    // 14. TEST PROBE
    // ==========================================
    match /test/{docId} {
      allow read: if isAuthenticated();
    }

    // ==========================================
    // 15. PHONE INDEX (Uniqueness Mapping)
    // ==========================================
    match /phoneIndex/{phone} {
      // Single-document lookups only (needed to claim a number); the index cannot be listed or scraped.
      allow get: if isAuthenticated();
      allow list: if isRealAdmin();
      allow create: if isAuthenticated() && (
        isRealAdmin() ||
        request.resource.data.get('uid', '') == request.auth.uid
      );
      // A number already claimed by another account can never be taken over
      allow update: if isAuthenticated() && (
        isRealAdmin() ||
        (
          resource.data.get('uid', '') == request.auth.uid &&
          request.resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow delete: if isAuthenticated() && (
        isRealAdmin() ||
        resource.data.get('uid', '') == request.auth.uid
      );
    }

    // ==========================================
    // 16. WALLET LEDGER (backend-written only)
    // ==========================================
    match /wallet_transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        isRealAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow write: if isRealAdmin();
    }

    // ==========================================
    // 17. BACKEND-ONLY SYSTEM COLLECTIONS
    // ==========================================
    // VodaPay payment sessions hold the one-time notification secret: backend only, never a client
    match /payment_sessions/{sessionId} {
      allow read, write: if isRealAdmin();
    }

    match /processed_webhooks/{webhookId} {
      allow read, write: if isRealAdmin();
    }

    match /system/{docId} {
      allow read, write: if isRealAdmin();
    }
  }
}
